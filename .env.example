# API Keys para La 12 Digital
# Copiar este archivo a .env y completar con tus keys

# ⚽ SofaScore — proxy Cloudflare Worker (OPCIONAL en Cloudflare Pages)
# En Cloudflare Pages la Functions en functions/api/sofascore/[[path]].js
# se encarga del proxy automáticamente sin necesidad de esta variable.
# Solo se necesita si desplegás en Vercel o querés usar un Worker independiente.
# Sigue los pasos en README.md → "Cloudflare Worker independiente"
# VITE_SOFASCORE_PROXY_URL=https://sofascore-proxy.yourname.workers.dev

# ⚽ TheSportsDB - PRINCIPAL
# https://www.thesportsdb.com/api.php
# Sin key → usa key pública "3" (free, limitada)
# Con key premium → descomentar y completar
# VITE_SPORTSDB_KEY=tu_key_premium_aqui

# ⚽ API-Football (RapidAPI) - alternativa (100 req/día gratis)
VITE_API_FOOTBALL_KEY=tu_rapidapi_key_aqui

# Configuración Boca Juniors
VITE_BOCA_TEAM_ID=451
VITE_BOCA_LEAGUE_ID=128
VITE_CURRENT_SEASON=2025

# 🌤️ OpenWeather API (para widget La Bombonera)
VITE_OPENWEATHER_KEY=tu_openweather_key_aqui

# 📺 YouTube Data API (para videos del canal)
VITE_YOUTUBE_KEY=tu_youtube_key_aqui
VITE_BOCA_YOUTUBE_CHANNEL=UCxwHmLY33JYIbyfew-kW7dQ

# 📰 NewsData.io (noticias)
VITE_NEWS_API_KEY=tu_newsapi_key_aqui
