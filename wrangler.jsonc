{
  // Cloudflare Workers configuration for La 12 Digital.
  // Build & deploy: npm run deploy
  //   (runs: tsc && vite build && wrangler deploy)
  //
  // The Worker serves:
  //   /api/sofascore/*  → proxied to api.sofascore.com (see worker.js)
  //   everything else   → React SPA from ./dist via Workers Assets
  "name": "la-12-digital",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true,
  },
  "assets": {
    // Vite builds the React SPA into ./dist — Workers Assets serves it.
    "directory": "./dist",
    // Serve index.html for any path not matched by a static file (SPA routing).
    "not_found_handling": "single-page-application",
    // Cache headers para assets estáticos — mejoran Core Web Vitals (LCP/FID)
    // Los assets de Vite tienen hash en el nombre → inmutable (1 año)
    // index.html y archivos SEO no deben cachearse con TTL largo
    "headers": {
      // JS/CSS con content hash de Vite → inmutables, 1 año de cache
      "/assets/*.js": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "/assets/*.css": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      // Imágenes estáticas de /public → 30 días, revalidar
      "/*.png": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      "/*.webp": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      // Archivos SEO — no cachear (deben reflejar cambios al instante)
      "/robots.txt": {
        "Cache-Control": "public, max-age=86400"
      },
      "/sitemap.xml": {
        "Cache-Control": "public, max-age=86400"
      },
      "/manifest.json": {
        "Cache-Control": "public, max-age=86400"
      },
    },
  },
  "compatibility_flags": ["nodejs_compat"],
  // API keys for the proxy handlers are stored as Cloudflare secrets (wrangler secret put).
  // They are NOT in this file — secrets persist through deploys and are never committed to git.
}
